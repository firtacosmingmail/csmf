# Same project as apps/mcp-server/.env / apps/web/.env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Credentials for the single admin account (the one you log into /admin
# with). Kept in memory for the life of the serverless instance only.
SUPABASE_ADMIN_EMAIL=you@example.com
SUPABASE_ADMIN_PASSWORD=your-admin-password

# Shared secret this endpoint requires as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
