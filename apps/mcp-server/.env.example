# Same project as apps/web/.env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Credentials for the single admin account (the one you log into /admin
# with). The server signs in with these once and holds the session in
# memory for the life of the process — nothing is written to disk.
SUPABASE_ADMIN_EMAIL=you@example.com
SUPABASE_ADMIN_PASSWORD=your-admin-password
