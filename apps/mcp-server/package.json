{
  "name": "@csmf/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for authoring csmf.ro blog posts through the same Edge Functions REST API the admin UI uses, so an AI agent can create/edit/publish posts without opening the admin page.",
  "bin": {
    "csmf-mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/create-server.d.ts",
      "default": "./dist/create-server.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
